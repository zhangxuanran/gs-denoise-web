    if (cloud.scales[si+2] > sm) sm = cloud.scales[si+2];
    scales[i] = sm;
    alphas[i] = cloud.opacities[s];
  }
  var cx = (minX + maxX) / 2, cy = (minY + maxY) / 2, cz = (minZ + maxZ) / 2;
  var radius = Math.max(1e-4, 0.5 * Math.hypot(maxX - minX, maxY - minY, maxZ - minZ));
  var sizeCap = radius * 0.1;
  for (var ci = 0; ci < count; ci++) { if (scales[ci] > sizeCap) scales[ci] = sizeCap; }

  var geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
  geo.setAttribute('aScale', new THREE.BufferAttribute(scales, 1));
  geo.setAttribute('aAlpha', new THREE.BufferAttribute(alphas, 1));
  geo.boundingSphere = new THREE.Sphere(new THREE.Vector3(cx, cy, cz), radius);
  geo.userData = { center: new THREE.Vector3(cx, cy, cz), radius: radius, count: count, originalIndices: originalIndices };
  return geo;
}

function updateViewerFocal() {
  if (!viewerRenderer || !viewerCamera || !viewerPoints) return;
  var h = viewerRenderer.domElement.height;
  var fovRad = viewerCamera.fov * Math.PI / 180;
  viewerPoints.material.uniforms.uFocal.value = h / (2 * Math.tan(fovRad / 2));
  viewerPoints.material.uniforms.uMaxPointSize.value = Math.min(h * 0.3, 400);
}

function resetViewerCamera() {
  if (!viewerPoints || !viewerCamera || !viewerControls) return;
  var meta = viewerPoints.geometry.userData;
  var posAttr = viewerPoints.geometry.getAttribute('position');
  var arr = posAttr.array, total = posAttr.count;
  var aAlphaAttr = viewerPoints.geometry.getAttribute('aAlpha');
  var aAlphaArr = aAlphaAttr ? aAlphaAttr.array : null;
  var sampleStep = Math.max(1, Math.floor(total / 50000));
  var sumW = 0, cx = 0, cy = 0, cz = 0;
  for (var i = 0; i < total; i += sampleStep) {
    var w = (aAlphaArr ? aAlphaArr[i] : 0.05) + 0.01;
    cx += arr[3*i] * w;
    cy += arr[3*i+1] * w;
    cz += arr[3*i+2] * w;
    sumW += w;
  }
  if (sumW > 0) { cx /= sumW; cy /= sumW; cz /= sumW; }
  else { cx = meta.center.x; cy = meta.center.y; cz = meta.center.z; }

  var dists = [];
  for (var j = 0; j < total; j += sampleStep) {
    var dx = arr[3*j] - cx, dy = arr[3*j+1] - cy, dz = arr[3*j+2] - cz;
    dists.push(Math.sqrt(dx*dx + dy*dy + dz*dz));
  }
  dists.sort(function (a, b) { return a - b; });
  var L = dists.length;
  var r50 = L > 0 ? dists[Math.floor(L * 0.50)] : 1e-4;
  var r75 = L > 0 ? dists[Math.floor(L * 0.75)] : r50;
  var r95 = L > 0 ? dists[Math.min(L - 1, Math.floor(L * 0.95))] : r75;
  r50 = Math.max(r50, 1e-4);
  r75 = Math.max(r75, r50);
  r95 = Math.max(r95, r75);

  var fovRad = viewerCamera.fov * Math.PI / 180;
  var dist = r75 / Math.tan(fovRad / 2) / 0.65;
  dist = Math.max(dist, r75 * 1.5);
  dist = Math.min(dist, r95 * 10);

  var center = new THREE.Vector3(cx, cy, cz);
  var dir = new THREE.Vector3(0, 0.25, 1).normalize();
  viewerCamera.position.copy(center).addScaledVector(dir, dist);
  viewerCamera.near = Math.max(0.001, r50 * 0.001);
  viewerCamera.far = Math.max(r95 * 1000, dist * 100);
  viewerCamera.updateProjectionMatrix();
  viewerControls.target.copy(center);
  viewerControls.minDistance = Math.max(0.001, r50 * 0.02);
  viewerControls.maxDistance = Math.max(r95 * 50, dist * 5);
  viewerControls.update();
  updateViewerFocal();
  invalidateScreenCache();
  requestViewerRender();
}

function requestViewerRender() {
  if (viewerRafId !== null) return;
  viewerRafId = requestAnimationFrame(function () {
    viewerRafId = null;
    if (!viewerRenderer) return;
    if (viewerControls) viewerControls.update();
    viewerRenderer.render(viewerScene, viewerCamera);
  });
}

function resizeViewer() {
  if (!viewerRenderer) return;
  var wrap = document.getElementById('wrapViewer');
  var w = Math.max(1, wrap.clientWidth), h = Math.max(1, wrap.clientHeight);
  viewerRenderer.setSize(w, h, false);
  viewerCamera.aspect = w / h;
  viewerCamera.updateProjectionMatrix();
  updateViewerFocal();
  invalidateScreenCache();
  requestViewerRender();
}

function updateViewerScene() {
  initViewerRenderer();
  var cloud = resultCloud || sourceCloud;

  if (cloud !== _lastEditCloudRef) {
    clearEditState();
    _lastEditCloudRef = cloud;
  }

  var emptyEl = document.getElementById('viewerEmpty');
  var badgeEl = document.getElementById('viewerBadge');
  if (!cloud || cloud.count === 0) {
    if (viewerPoints) { viewerScene.remove(viewerPoints); viewerPoints.geometry.dispose(); viewerPoints.material.dispose(); viewerPoints = null; }
    emptyEl.style.display = 'flex';
    badgeEl.style.display = 'none';
    invalidateScreenCache();
    requestViewerRender();
    return;
  }
  emptyEl.style.display = 'none';
  if (viewerPoints) { viewerScene.remove(viewerPoints); viewerPoints.geometry.dispose(); viewerPoints.material.dispose(); viewerPoints = null; }
  var geo = buildViewerGeometry(cloud);
  var mat = createViewerMaterial();
  viewerPoints = new THREE.Points(geo, mat);
  viewerScene.add(viewerPoints);
  invalidateScreenCache();
  var isDst = !!resultCloud;
  badgeEl.textContent = isDst ? '降噪处理后效果' : '原始模型效果';
  badgeEl.style.display = 'block';
  resetViewerCamera();
}

var keys = {}, keyMoveRaf = null;
function processKeyboardControls() {
  if (!viewerCamera || !viewerControls || !viewerPoints) return false;
  var dist = viewerControls.target.distanceTo(viewerCamera.position) || 1;
  var moveSpeed = dist * 0.5 * 0.016;
  var rotateSpeed = 1.5 * 0.016;
  var moveVec = new THREE.Vector3();
  var forward = new THREE.Vector3(0, 0, -1).applyQuaternion(viewerCamera.quaternion);
  var right = new THREE.Vector3(1, 0, 0).applyQuaternion(viewerCamera.quaternion);
  var up = new THREE.Vector3(0, 1, 0).applyQuaternion(viewerCamera.quaternion);
  if (keys['w']) moveVec.addScaledVector(forward, moveSpeed);
  if (keys['s']) moveVec.addScaledVector(forward, -moveSpeed);
  if (keys['a']) moveVec.addScaledVector(right, -moveSpeed);
  if (keys['d']) moveVec.addScaledVector(right, moveSpeed);
  if (keys['q']) moveVec.addScaledVector(up, -moveSpeed);
  if (keys['e']) moveVec.addScaledVector(up, moveSpeed);
  if (moveVec.lengthSq() > 0) {
    viewerCamera.position.add(moveVec);
    viewerControls.target.add(moveVec);
    invalidateScreenCache();
  }
  var rotX = 0, rotY = 0;
  if (keys['arrowleft']) rotX -= rotateSpeed;
  if (keys['arrowright']) rotX += rotateSpeed;
  if (keys['arrowup']) rotY -= rotateSpeed;
  if (keys['arrowdown']) rotY += rotateSpeed;
  if (rotX !== 0 || rotY !== 0) {
    var offset = new THREE.Vector3().subVectors(viewerControls.target, viewerCamera.position);
    var spherical = new THREE.Spherical().setFromVector3(offset);
    spherical.theta -= rotX;
    spherical.phi -= rotY;
    spherical.phi = Math.max(0.01, Math.min(Math.PI - 0.01, spherical.phi));
    offset.setFromSpherical(spherical);
    viewerControls.target.copy(viewerCamera.position).add(offset);
    invalidateScreenCache();
  }
  viewerControls.update();
  return true;
}

function ensureKeyMoveLoop() {
  if (keyMoveRaf !== null) return;
  function loop() {
    keyMoveRaf = null;
    var any = false;
    for (var k in keys) { if (keys[k]) { any = true; break; } }
    if (!any || !panelViewer.classList.contains('active')) return;
    processKeyboardControls();
    if (viewerRenderer) viewerRenderer.render(viewerScene, viewerCamera);
    keyMoveRaf = requestAnimationFrame(loop);
  }
  keyMoveRaf = requestAnimationFrame(loop);
}

window.addEventListener('keydown', function (e) {
  var k = e.key.toLowerCase();
  keys[k] = true;
  if (k === 'w' || k === 'a' || k === 's' || k === 'd' || k === 'q' || k === 'e' ||
      k === 'arrowup' || k === 'arrowdown' || k === 'arrowleft' || k === 'arrowright') {
    ensureKeyMoveLoop();
  }
});
window.addEventListener('keyup', function (e) { keys[e.key.toLowerCase()] = false; });

window.setGizmoView = function (axis) {
  if (!viewerCamera || !viewerControls || !viewerPoints) return;
  var target = viewerControls.target.clone();
  var dist = viewerControls.target.distanceTo(viewerCamera.position);
  var offset = new THREE.Vector3();
  if (axis === 'x') offset.set(1, 0, 0);
  else if (axis === '-x') offset.set(-1, 0, 0);
  else if (axis === 'y') offset.set(0, 1, 0);
  else if (axis === '-y') offset.set(0, -1, 0);
  else if (axis === 'z') offset.set(0, 0, 1);
  else if (axis === '-z') offset.set(0, 0, -1);
  offset.normalize().multiplyScalar(dist);
  viewerCamera.position.copy(target).add(offset);
  viewerCamera.lookAt(target);
  viewerControls.update();
  invalidateScreenCache();
  requestViewerRender();
};

window.resetViewerCamera = function () { resetViewerCamera(); };
document.getElementById('btnViewerResetCam').addEventListener('click', function () { resetViewerCamera(); });

var editState = {
  tool: null,
  history: [],
  pending: null,
  brushSize: 40
};

var _editDragging = false;
var _editScheduled = false;
var _pendingEditPos = null;
var _lastEditCloudRef = null;

var _screenX = null, _screenY = null, _screenValid = false;
var _screenGeomRef = null;

function invalidateScreenCache() {
  _screenValid = false;
  _screenGeomRef = null;
}

function buildScreenCache() {
  if (!viewerPoints || !viewerCamera || !viewerRenderer) return false;
  var geo = viewerPoints.geometry;
  var posAttr = geo.getAttribute('position');
  if (!posAttr) return false;
  var posArr = posAttr.array;
  var count = posAttr.count;
  if (!_screenX || _screenX.length < count) {
    _screenX = new Float32Array(count);
    _screenY = new Float32Array(count);
  }
  var renderW = viewerRenderer.domElement.width;
  var renderH = viewerRenderer.domElement.height;

  viewerCamera.updateMatrixWorld();
  var viewProjMat = new THREE.Matrix4().multiplyMatrices(viewerCamera.projectionMatrix, viewerCamera.matrixWorldInverse);
  var m = viewProjMat.elements;

  for (var i = 0; i < count; i++) {
    var o3 = i * 3;
    var x = posArr[o3], y = posArr[o3+1], z = posArr[o3+2];
    var w = m[3]*x + m[7]*y + m[11]*z + m[15];
    if (w <= 0) {
      _screenX[i] = -1e9;
      _screenY[i] = -1e9;
      continue;
    }
    var nx = (m[0]*x + m[4]*y + m[8]*z + m[12]) / w;
    var ny = (m[1]*x + m[5]*y + m[9]*z + m[13]) / w;
    _screenX[i] = (nx * 0.5 + 0.5) * renderW;
    _screenY[i] = (-ny * 0.5 + 0.5) * renderH;
  }

  _screenValid = true;
  _screenGeomRef = geo;
  return true;
}

function applyEditAt(clientX, clientY) {
  if (!editState.tool) return;
  if (!viewerPoints || !viewerCamera || !viewerRenderer) return;
  var cloud = resultCloud || sourceCloud;
  if (!cloud) return;

  var geo = viewerPoints.geometry;
  var posAttr = geo.getAttribute('position');
  var aAlphaAttr = geo.getAttribute('aAlpha');
  if (!posAttr || !aAlphaAttr) return;

  var aAlpha = aAlphaAttr.array;
  var count = posAttr.count;
  var originalIndices = geo.userData.originalIndices;
  if (!originalIndices) return;

  if (!_screenValid || _screenGeomRef !== geo) {
    if (!buildScreenCache()) return;
  }

  var domRect = viewerRenderer.domElement.getBoundingClientRect();
  var renderW = viewerRenderer.domElement.width;
  var renderH = viewerRenderer.domElement.height;
  var ratioX = renderW / domRect.width;
  var ratioY = renderH / domRect.height;
  var cx = (clientX - domRect.left) * ratioX;
  var cy = (clientY - domRect.top) * ratioY;
  var r = editState.brushSize * Math.max(ratioX, ratioY);
  var r2 = r * r;

  var changes = [];
  var anyModified = false;

  for (var i = 0; i < count; i++) {
    var sx = _screenX[i];
    if (sx < -1e8) continue;
    var sy = _screenY[i];
    var dx = sx - cx, dy = sy - cy;
    var d2 = dx*dx + dy*dy;
    if (d2 > r2) continue;

    var oldOp = aAlpha[i];
    if (oldOp < 0.01) continue;
    aAlpha[i] = 0;
    var oi = originalIndices[i];
    cloud.opacities[oi] = 0;
    changes.push({ i: i, oldOp: oldOp });
    anyModified = true;
  }

  if (!anyModified) return;

  aAlphaAttr.needsUpdate = true;

  if (!editState.pending) {
    editState.pending = { type: editState.tool, changes: changes };
  } else {
    for (var k = 0; k < changes.length; k++) editState.pending.changes.push(changes[k]);
  }

  requestViewerRender();
}

function queueEdit(clientX, clientY) {
  _pendingEditPos = { x: clientX, y: clientY };
  if (_editScheduled) return;
  _editScheduled = true;
  requestAnimationFrame(function () {
    _editScheduled = false;
    if (_pendingEditPos) {
      var p = _pendingEditPos;
      _pendingEditPos = null;
      applyEditAt(p.x, p.y);
    }
  });
}

function updateBrushCursor(clientX, clientY) {
  var el = document.getElementById('brushCursor');
  if (!el) return;
  if (!editState.tool) { el.style.display = 'none'; return; }
  var wrap = document.getElementById('wrapViewer');
  var rect = wrap.getBoundingClientRect();
  var size = editState.brushSize * 2;
  el.style.display = 'block';
  el.style.left = (clientX - rect.left) + 'px';
  el.style.top = (clientY - rect.top) + 'px';
  el.style.width = size + 'px';
  el.style.height = size + 'px';
}

function undoEdit() {
  if (editState.pending) {
    editState.history.push(editState.pending);
    editState.pending = null;
  }
  if (editState.history.length === 0) return;
  var op = editState.history.pop();
  if (!viewerPoints) return;
  var geo = viewerPoints.geometry;
  var aAlphaAttr = geo.getAttribute('aAlpha');
  if (!aAlphaAttr) return;
  var aAlpha = aAlphaAttr.array;
  var originalIndices = geo.userData.originalIndices;
  var cloud = resultCloud || sourceCloud;

  for (var k = op.changes.length - 1; k >= 0; k--) {
    var c = op.changes[k];
    aAlpha[c.i] = c.oldOp;
    if (originalIndices && cloud) {
      var oi = originalIndices[c.i];
      cloud.opacities[oi] = c.oldOp;
    }
  }
  aAlphaAttr.needsUpdate = true;
  requestViewerRender();
  updateEditToolUI();
}

function resetEdits() {
  if (editState.pending) {
    editState.history.push(editState.pending);
    editState.pending = null;
  }
  while (editState.history.length > 0) {
    undoEdit();
  }
  updateEditToolUI();
}

function setEditTool(tool) {
  if (editState.tool === tool) tool = null;
  editState.tool = tool;
  updateEditToolUI();
  if (viewerControls) viewerControls.enabled = (tool === null);
  if (viewerRenderer) {
    viewerRenderer.domElement.style.cursor = tool ? 'crosshair' : '';
  }
  var optEl = document.getElementById('toolOptions');
  var curEl = document.getElementById('brushCursor');
  if (tool === null) {
    if (optEl) optEl.style.display = 'none';
    if (curEl) curEl.style.display = 'none';
  } else {
    if (optEl) optEl.style.display = 'flex';
    if (curEl) {
      curEl.style.borderColor = '#ef4444';
    }
  }
}

function updateEditToolUI() {
  var btnE = document.getElementById('btnToolEraser');
  var btnU = document.getElementById('btnToolUndo');
  var btnR = document.getElementById('btnToolReset');
  if (btnE) btnE.classList.toggle('active', editState.tool === 'eraser');
  var hasHistory = editState.history.length > 0 || (editState.pending && editState.pending.changes.length > 0);
  if (btnU) btnU.disabled = !hasHistory;
  if (btnR) btnR.disabled = !hasHistory;
}

function clearEditState() {
  editState.history = [];
  editState.pending = null;
  _editDragging = false;
  invalidateScreenCache();
  updateEditToolUI();
}

(function bindEditEvents() {
  var btnE = document.getElementById('btnToolEraser');
  var btnU = document.getElementById('btnToolUndo');
  var btnR = document.getElementById('btnToolReset');
  if (btnE) btnE.addEventListener('click', function () { setEditTool('eraser'); });
  if (btnU) btnU.addEventListener('click', function () { undoEdit(); });
  if (btnR) btnR.addEventListener('click', function () { resetEdits(); });

  var sliderSize = document.getElementById('sliderBrushSize');
  if (sliderSize) sliderSize.addEventListener('input', function () {
    editState.brushSize = parseInt(this.value, 10);
  });

  var wrap = document.getElementById('wrapViewer');
  if (!wrap) return;

  function isUIElement(target) {
    return target.closest('.viewer-tool-options') || 
           target.closest('.viewer-gizmo') || 
           target.closest('button');
  }

  wrap.addEventListener('mousemove', function (e) {
    if (!editState.tool) return;
    updateBrushCursor(e.clientX, e.clientY);
    if (_editDragging) queueEdit(e.clientX, e.clientY);
  });

  wrap.addEventListener('mouseleave', function () {
    var el = document.getElementById('brushCursor');
    if (el) el.style.display = 'none';
  });

  wrap.addEventListener('mousedown', function (e) {
    if (!editState.tool) return;
    if (e.button !== 0) return;
    if (!viewerPoints) return;
    if (isUIElement(e.target)) return;
    
    e.preventDefault();
    _editDragging = true;
    editState.pending = null;
    updateEditToolUI();
    queueEdit(e.clientX, e.clientY);
  });

  window.addEventListener('mouseup', function () {
    if (!_editDragging) return;
    _editDragging = false;
    if (editState.pending && editState.pending.changes.length > 0) {
      editState.history.push(editState.pending);
      editState.pending = null;
    }
    updateEditToolUI();
  });

  wrap.addEventListener('touchstart', function (e) {
    if (!editState.tool) return;
    if (!viewerPoints) return;
    if (isUIElement(e.target)) return;
    
    e.preventDefault();
    var t = e.touches[0];
    _editDragging = true;
    editState.pending = null;
    updateBrushCursor(t.clientX, t.clientY);
    queueEdit(t.clientX, t.clientY);
  }, { passive: false });

  wrap.addEventListener('touchmove', function (e) {
    if (!editState.tool || !_editDragging) return;
    e.preventDefault();
    var t = e.touches[0];
    updateBrushCursor(t.clientX, t.clientY);
    queueEdit(t.clientX, t.clientY);
  }, { passive: false });

  wrap.addEventListener('touchend', function () {
    if (!_editDragging) return;
    _editDragging = false;
    if (editState.pending && editState.pending.changes.length > 0) {
      editState.history.push(editState.pending);
      editState.pending = null;
    }
    updateEditToolUI();
  });
})();

