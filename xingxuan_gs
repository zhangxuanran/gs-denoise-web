var _sinY = 0, _cosY = 1, _sinX = 0, _cosX = 1, _focal = 1000, _dist = 3;
function precomputeCamera(w, h) {
  _sinY = Math.sin(camera.rotY); _cosY = Math.cos(camera.rotY);
  _sinX = Math.sin(camera.rotX); _cosX = Math.cos(camera.rotX);
  _focal = h / (2 * Math.tan((camera.fov * Math.PI / 180) / 2));
  _dist = camera.dist;
