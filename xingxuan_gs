<script>
(function () {
'use strict';

var SH_C0 = 0.28209479177387814;
var sigmoid = function (x) { return 1 / (1 + Math.exp(-x)); };
var logit = function (p) { p = Math.min(Math.max(p, 1e-6), 1 - 1e-6); return Math.log(p / (1 - p)); };
var clampByte = function (v) { return Math.max(0, Math.min(255, Math.round(v))); };
var clamp01 = function (v) { return Math.max(0, Math.min(1, v)); };
var nextFrame = function () { return new Promise(function (r) { requestAnimationFrame(function () { r(); }); }); };
var IS_MOBILE = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
var MAX_2D_POINTS = 30000;
var MAX_VIEWER_POINTS = IS_MOBILE ? 400000 : 1500000;

var PLY_TYPE_SIZE = { char:1,int8:1,uchar:1,uint8:1,short:2,int16:2,ushort:2,uint16:2,int:4,int32:4,uint:4,uint32:4,float:4,float32:4,double:8,float64:8 };

function initDots() {
  var canvas = document.getElementById('bg-canvas');
  var ctx = canvas.getContext('2d');
  var width, height, dots = [];
  var count = window.innerWidth < 900 ? 200 : 800;
  function resize() {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
  }
  window.addEventListener('resize', resize); resize();

  for (var i = 0; i < count; i++) {
    dots.push({
      x: Math.random() * width,
      y: Math.random() * height,
      r: Math.random() * 1.5 + 0.5,
      a: Math.random() * 0.4 + 0.1
    });
  }
  function draw() {
    if (document.getElementById('landing-page').classList.contains('fade-out')) return;
    ctx.clearRect(0, 0, width, height);
    for (var d = 0; d < dots.length; d++) {
      var dot = dots[d];
      ctx.beginPath();
      ctx.arc(dot.x, dot.y, dot.r, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(8, 145, 178, ' + dot.a + ')';
      ctx.fill();
    }
    requestAnimationFrame(draw);
  }
  draw();
}
initDots();

document.getElementById('btn-enter').addEventListener('click', function () {
  var landing = document.getElementById('landing-page');
  landing.classList.add('fade-out');
  setTimeout(function () {
    landing.style.display = 'none';
    resize2D();
    resizeViewer();
    if (typeof updateViewerScene === 'function') updateViewerScene();
  }, 800);
});

function GaussianCloud(count) {
  this.count = count;
  this.positions = new Float32Array(3 * count);
  this.scales = new Float32Array(3 * count);
  this.rotations = new Float32Array(4 * count);
  this.opacities = new Float32Array(count);
  this.colors = new Uint8Array(3 * count);
}

GaussianCloud.fromSplat = function (arrayBuffer) {
  if (arrayBuffer.byteLength % 32 !== 0) throw new Error('.splat 文件长度 ' + arrayBuffer.byteLength + ' 字节，不是 32 的整数倍');
  var count = arrayBuffer.byteLength / 32, cloud = new GaussianCloud(count), view = new DataView(arrayBuffer), u8 = new Uint8Array(arrayBuffer);
  for (var i = 0; i < count; i++) {
    var o = i * 32;
    cloud.positions[3*i]   = view.getFloat32(o+0, true);
    cloud.positions[3*i+1] = view.getFloat32(o+4, true);
    cloud.positions[3*i+2] = view.getFloat32(o+8, true);
    cloud.scales[3*i]   = view.getFloat32(o+12, true);
    cloud.scales[3*i+1] = view.getFloat32(o+16, true);
    cloud.scales[3*i+2] = view.getFloat32(o+20, true);
    cloud.colors[3*i]   = u8[o+24];
    cloud.colors[3*i+1] = u8[o+25];
    cloud.colors[3*i+2] = u8[o+26];
    cloud.opacities[i]  = u8[o+27] / 255;
    var qw = (u8[o+28] - 128) / 128, qx = (u8[o+29] - 128) / 128, qy = (u8[o+30] - 128) / 128, qz = (u8[o+31] - 128) / 128;
    var len = Math.hypot(qw, qx, qy, qz) || 1;
    cloud.rotations[4*i]   = qw / len;
    cloud.rotations[4*i+1] = qx / len;
    cloud.rotations[4*i+2] = qy / len;
    cloud.rotations[4*i+3] = qz / len;
  }
  return cloud;
};

GaussianCloud.prototype.subset = function (indices) {
  var n = indices.length, out = new GaussianCloud(n);
  for (var k = 0; k < n; k++) {
    var i = indices[k];
    out.positions[3*k]   = this.positions[3*i];
    out.positions[3*k+1] = this.positions[3*i+1];
    out.positions[3*k+2] = this.positions[3*i+2];
    out.scales[3*k]   = this.scales[3*i];
    out.scales[3*k+1] = this.scales[3*i+1];
    out.scales[3*k+2] = this.scales[3*i+2];
    out.rotations[4*k]   = this.rotations[4*i];
    out.rotations[4*k+1] = this.rotations[4*i+1];
    out.rotations[4*k+2] = this.rotations[4*i+2];
    out.rotations[4*k+3] = this.rotations[4*i+3];
    out.opacities[k] = this.opacities[i];
    out.colors[3*k]   = this.colors[3*i];
    out.colors[3*k+1] = this.colors[3*i+1];
    out.colors[3*k+2] = this.colors[3*i+2];
  }
  return out;
};

GaussianCloud.prototype.toSplat = function (indices) {
  var n = indices.length, out = new Uint8Array(n * 32), view = new DataView(out.buffer);
  for (var k = 0; k < n; k++) {
    var i = indices[k], o = k * 32;
    view.setFloat32(o+0,  this.positions[3*i], true);
    view.setFloat32(o+4,  this.positions[3*i+1], true);
    view.setFloat32(o+8,  this.positions[3*i+2], true);
    view.setFloat32(o+12, this.scales[3*i], true);
    view.setFloat32(o+16, this.scales[3*i+1], true);
    view.setFloat32(o+20, this.scales[3*i+2], true);
    out[o+24] = clampByte(this.colors[3*i]);
    out[o+25] = clampByte(this.colors[3*i+1]);
    out[o+26] = clampByte(this.colors[3*i+2]);
    out[o+27] = clampByte(this.opacities[i] * 255);
    out[o+28] = clampByte(this.rotations[4*i]   * 128 + 128);
    out[o+29] = clampByte(this.rotations[4*i+1] * 128 + 128);
    out[o+30] = clampByte(this.rotations[4*i+2] * 128 + 128);
    out[o+31] = clampByte(this.rotations[4*i+3] * 128 + 128);
  }
  return out;
};

GaussianCloud.prototype.toPly = function (indices) {
  var n = indices.length;
  var headerParts = [
    'ply',
    'format binary_little_endian 1.0',
    'comment generated by 3DGS Denoise Tool',
    'element vertex ' + n,
    'property float x',
    'property float y',
    'property float z',
    'property float f_dc_0',
    'property float f_dc_1',
    'property float f_dc_2',
    'property uchar red',
    'property uchar green',
    'property uchar blue',
    'property float opacity',
    'property float scale_0',
    'property float scale_1',
    'property float scale_2',
    'property float rot_0',
    'property float rot_1',
    'property float rot_2',
    'property float rot_3',
    'end_header',
    ''
  ];

  var header = headerParts.join('\n');
  var headerBytes = new TextEncoder().encode(header);
  var floatCount = 3 + 3 + 1 + 3 + 4; 
  var VERTEX_BYTES = floatCount * 4 + 3;
  var out = new Uint8Array(headerBytes.length + n * VERTEX_BYTES);
  out.set(headerBytes, 0);
  var view = new DataView(out.buffer, headerBytes.length);
  var p = 0;
  for (var k = 0; k < n; k++) {
    var idx = indices[k];
    view.setFloat32(p, this.positions[3*idx], true);   p += 4;
    view.setFloat32(p, this.positions[3*idx+1], true); p += 4;
    view.setFloat32(p, this.positions[3*idx+2], true); p += 4;
    
    view.setFloat32(p, (this.colors[3*idx]   / 255 - 0.5) / SH_C0, true); p += 4;
    view.setFloat32(p, (this.colors[3*idx+1] / 255 - 0.5) / SH_C0, true); p += 4;
    view.setFloat32(p, (this.colors[3*idx+2] / 255 - 0.5) / SH_C0, true); p += 4;
    view.setUint8(p, clampByte(this.colors[3*idx]));   p += 1;
    view.setUint8(p, clampByte(this.colors[3*idx+1])); p += 1;
    view.setUint8(p, clampByte(this.colors[3*idx+2])); p += 1;
    
    view.setFloat32(p, logit(this.opacities[idx]), true); p += 4;
    view.setFloat32(p, Math.log(Math.max(this.scales[3*idx],   1e-12)), true); p += 4;
    view.setFloat32(p, Math.log(Math.max(this.scales[3*idx+1], 1e-12)), true); p += 4;
    view.setFloat32(p, Math.log(Math.max(this.scales[3*idx+2], 1e-12)), true); p += 4;
    view.setFloat32(p, this.rotations[4*idx],   true); p += 4;
    view.setFloat32(p, this.rotations[4*idx+1], true); p += 4;
    view.setFloat32(p, this.rotations[4*idx+2], true); p += 4;
    view.setFloat32(p, this.rotations[4*idx+3], true); p += 4;
  }
  return out;
};

function identityIndices(n) {
  var a = new Uint32Array(n);
  for (var i = 0; i < n; i++) a[i] = i;
  return a;
}

var PLY_WORKER_SOURCE = [
  '"use strict";',
  'var PLY_TYPE_SIZE = ' + JSON.stringify(PLY_TYPE_SIZE) + ';',
  'var SH_C0 = ' + SH_C0 + ';',
  'function readPlyValue(view, offset, type, le) {',
  '  switch (type) {',
  '    case "char": case "int8": return view.getInt8(offset);',
  '    case "uchar": case "uint8": return view.getUint8(offset);',
  '    case "short": case "int16": return view.getInt16(offset, le);',
  '    case "ushort": case "uint16": return view.getUint16(offset, le);',
  '    case "int": case "int32": return view.getInt32(offset, le);',
  '    case "uint": case "uint32": return view.getUint32(offset, le);',
  '    case "float": case "float32": return view.getFloat32(offset, le);',
  '    case "double": case "float64": return view.getFloat64(offset, le);',
  '  }',
  '  throw new Error("未知 PLY 属性类型: " + type);',
  '}',
  'function findHeaderEnd(bytes) {',
  '  var marker = "end_header", m = marker.length, limit = Math.min(bytes.length, 65536);',
  '  for (var i = 0; i + m <= limit; i++) {',
  '    var ok = true;',
  '    for (var j = 0; j < m; j++) { if (bytes[i + j] !== marker.charCodeAt(j)) { ok = false; break; } }',
  '    if (!ok) continue;',
  '    var p = i + m; if (bytes[p] === 13) p++; if (bytes[p] === 10) p++;',
  '    return p;',
  '  }',
  '  return -1;',
  '}',
  'function clampByte(v) { return Math.max(0, Math.min(255, Math.round(v))); }',
  'function clamp01(v) { return Math.max(0, Math.min(1, v)); }',
  'function sigmoid(x) { return 1 / (1 + Math.exp(-x)); }',
  'function parsePly(arrayBuffer) {',
  '  var bytes = new Uint8Array(arrayBuffer), headerEnd = findHeaderEnd(bytes);',
  '  if (headerEnd < 0) throw new Error("PLY 文件缺少 end_header 标记");',
  '  var headerText = new TextDecoder().decode(bytes.subarray(0, headerEnd));',
  '  var lines = headerText.split(/\\r?\\n/);',
  '  var format = null, elements = [], current = null;',
  '  for (var li = 0; li < lines.length; li++) {',
  '    var line = lines[li].trim(); if (!line) continue;',
  '    var t = line.split(/\\s+/), key = t[0].toLowerCase();',
  '    if (key === "ply" || key === "comment" || key === "obj_info") continue;',
  '    if (key === "format") format = (t[1] || "").toLowerCase();',
  '    else if (key === "element") { current = { name: t[1], count: parseInt(t[2], 10), properties: [] }; elements.push(current); }',
  '    else if (key === "property" && current) {',
  '      if (t[1] === "list") current.properties.push({ isList: true, name: t[4] || "" });',
  '      else current.properties.push({ isList: false, type: t[1], name: t[2] });',
  '    }',
  '  }',
  '  if (!format) throw new Error("PLY 缺少 format 声明");',
  '  if (elements.length === 0 || elements[0].name !== "vertex") throw new Error("仅支持以 vertex 作为第一个 element 的 PLY");',
  '  var vertexEl = elements[0], vertexCount = vertexEl.count;',
  '  if (!Number.isFinite(vertexCount) || vertexCount <= 0) throw new Error("PLY vertex 数量无效");',
  '  var stride = 0, propIndex = {};',
  '  for (var pi = 0; pi < vertexEl.properties.length; pi++) {',
  '    var p = vertexEl.properties[pi];',
  '    if (p.isList) throw new Error("vertex 元素不支持 list 属性");',
  '    var size = PLY_TYPE_SIZE[p.type];',
  '    if (!size) throw new Error("未知 PLY 属性类型: " + p.type);',
  '    p.offset = stride; p.size = size; p.colIndex = pi; stride += size; propIndex[p.name] = p;',
  '  }',
  '  function need(n) { var pp = propIndex[n]; if (!pp) throw new Error("PLY 缺少属性 " + n); return pp; }',
  '  var pX = need("x"), pY = need("y"), pZ = need("z");',
  '  var pS0 = need("scale_0"), pS1 = need("scale_1"), pS2 = need("scale_2");',
  '  var pR0 = need("rot_0"), pR1 = need("rot_1"), pR2 = need("rot_2"), pR3 = need("rot_3");',
  '  var pOpacity = need("opacity");',
  '  var pDc0 = propIndex["f_dc_0"], pDc1 = propIndex["f_dc_1"], pDc2 = propIndex["f_dc_2"];',
  '  var pRed = propIndex["red"], pGreen = propIndex["green"], pBlue = propIndex["blue"];',
  '  var useDC = !!(pDc0 && pDc1 && pDc2), useRGB = !!(pRed && pGreen && pBlue);',
  '  if (!useDC && !useRGB) throw new Error("PLY 缺少颜色属性");',
  '  var positions = new Float32Array(vertexCount * 3);',
  '  var scales = new Float32Array(vertexCount * 3);',
  '  var rotations = new Float32Array(vertexCount * 4);',
  '  var opacities = new Float32Array(vertexCount);',
  '  var colors = new Uint8Array(vertexCount * 3);',
  '  function writePoint(i, get) {',
  '    positions[3*i]   = get(pX); positions[3*i+1] = get(pY); positions[3*i+2] = get(pZ);',
  '    scales[3*i]   = Math.exp(get(pS0));',
  '    scales[3*i+1] = Math.exp(get(pS1));',
  '    scales[3*i+2] = Math.exp(get(pS2));',
  '    var qw = get(pR0), qx = get(pR1), qy = get(pR2), qz = get(pR3);',
  '    var len = Math.hypot(qw, qx, qy, qz) || 1;',
  '    rotations[4*i]   = qw / len;',
  '    rotations[4*i+1] = qx / len;',
  '    rotations[4*i+2] = qy / len;',
  '    rotations[4*i+3] = qz / len;',
  '    opacities[i] = clamp01(sigmoid(get(pOpacity)));',
  '    if (useDC) {',
  '      colors[3*i]   = clampByte((0.5 + SH_C0 * get(pDc0)) * 255);',
  '      colors[3*i+1] = clampByte((0.5 + SH_C0 * get(pDc1)) * 255);',
  '      colors[3*i+2] = clampByte((0.5 + SH_C0 * get(pDc2)) * 255);',
  '    } else {',
  '      function conv(pp) { var v = get(pp); var isF = (pp.type === "float" || pp.type === "float32" || pp.type === "double" || pp.type === "float64"); return clampByte(isF ? v * 255 : v); }',
  '      colors[3*i]   = conv(pRed);',
  '      colors[3*i+1] = conv(pGreen);',
  '      colors[3*i+2] = conv(pBlue);',
  '    }',
  '  }',
  '  if (format === "binary_little_endian" || format === "binary_big_endian") {',
  '    var le = (format === "binary_little_endian"), view = new DataView(arrayBuffer, headerEnd);',
  '    for (var bi = 0; bi < vertexCount; bi++) {',
  '      (function (bi) {',
  '        var base = bi * stride;',
  '        writePoint(bi, function (pp) { return readPlyValue(view, base + pp.offset, pp.type, le); });',
  '      })(bi);',
  '    }',
  '  } else if (format === "ascii") {',
  '    var bodyText = new TextDecoder().decode(bytes.subarray(headerEnd));',
  '    var tokens = bodyText.match(/\\S+/g) || [];',
  '    var propCount = vertexEl.properties.length;',
  '    if (tokens.length < vertexCount * propCount) throw new Error("PLY ASCII 数据不足");',
  '    var nums = new Float64Array(propCount);',
  '    for (var ai = 0; ai < vertexCount; ai++) {',
  '      var base2 = ai * propCount;',
  '      for (var pi2 = 0; pi2 < propCount; pi2++) nums[pi2] = parseFloat(tokens[base2 + pi2]);',
  '      (function (ai) {',
  '        writePoint(ai, function (pp) { return nums[pp.colIndex]; });',
  '      })(ai);',
  '    }',
  '  } else {',
  '    throw new Error("不支持的 PLY format: " + format);',
  '  }',
  '  return { count: vertexCount, positions: positions, scales: scales, rotations: rotations, opacities: opacities, colors: colors };',
  '}',
  'self.onmessage = function (e) {',
  '  try {',
  '    var res = parsePly(e.data.buffer);',
  '    self.postMessage(res, [res.positions.buffer, res.scales.buffer, res.rotations.buffer, res.opacities.buffer, res.colors.buffer]);',
  '  } catch (err) {',
  '    self.postMessage({ error: err.message || String(err) });',
  '  }',
