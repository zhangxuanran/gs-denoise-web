btnRun.addEventListener('click', async function () {
  if (!sourceCloud || sourceCloud.count === 0) {
    infoBox.textContent = '请先加载文件';
    infoBox.classList.add('err');
    return;
  }
  if (isDenoiseRunning) return;

  var mode = denoiseModeEl.value;
  var thOpacity = parseFloat(sliderOpacity.value);
  var thScale = currentScaleThreshold();

  progressWrap.style.display = 'block';
  progressBar.style.width = '5%';
  infoBox.classList.remove('err', 'warn');

  if (mode === 'sor') {
    isDenoiseRunning = true;
    btnRun.disabled = true;
    btnRun.textContent = '计算中…';
    infoBox.textContent = '正在前端执行网格 SOR（Web Worker）…';
    infoBox.classList.remove('err', 'warn');
    progressBar.style.width = '10%';

    var n = sourceCloud.count;
    var kVal = parseInt(sliderSorK.value, 10);
    var stdVal = parseFloat(sliderSorStd.value);

    var mCount = 0;
    for (var p0 = 0; p0 < n; p0++) if (sourceCloud.opacities[p0] >= thOpacity) mCount++;
    if (mCount === 0) {
      applyDenoiseResult(new Uint32Array(0));
      return;
    }

    var candidates = new Uint32Array(mCount);
    var coords = new Float32Array(mCount * 3);
    var ci = 0;
    for (var p1 = 0; p1 < n; p1++) {
      if (sourceCloud.opacities[p1] >= thOpacity) {
        candidates[ci] = p1;
        coords[ci*3]   = sourceCloud.positions[p1*3];
        coords[ci*3+1] = sourceCloud.positions[p1*3+1];
        coords[ci*3+2] = sourceCloud.positions[p1*3+2];
        ci++;
      }
    }
    progressBar.style.width = '15%';
    await nextFrame();

    try {
      var keepRel = await computeSorAsync(coords, kVal, stdVal, function (p) {
        progressBar.style.width = (15 + p * 80).toFixed(1) + '%';
      });
      var keep = new Uint32Array(keepRel.length);
      for (var kk = 0; kk < keepRel.length; kk++) keep[kk] = candidates[keepRel[kk]];
      progressBar.style.width = '100%';
      applyDenoiseResult(keep);
    } catch (err) {
      console.error(err);
      infoBox.textContent = 'SOR 失败：' + (err.message || String(err));
      infoBox.classList.add('err');
      restoreRunButton();
      progressWrap.style.display = 'none';
    } finally {
      isDenoiseRunning = false;
    }
    return;
  }

  btnRun.disabled = true;
  progressBar.style.width = '50%';
  await nextFrame();
  try {
    var keepArr = [];
    if (mode === 'opacityOnly') {
      for (var a = 0; a < sourceCloud.count; a++) if (sourceCloud.opacities[a] >= thOpacity) keepArr.push(a);
    } else {
      for (var b = 0; b < sourceCloud.count; b++) {
        if (sourceCloud.opacities[b] < thOpacity) continue;
        var s = Math.max(sourceCloud.scales[b*3], sourceCloud.scales[b*3+1], sourceCloud.scales[b*3+2]);
        if (s > thScale) continue;
        keepArr.push(b);
      }
    }
    progressBar.style.width = '100%';
    applyDenoiseResult(keepArr);
  } catch (err) {
    infoBox.textContent = '降噪失败：' + err.message;
    infoBox.classList.add('err');
    restoreRunButton();
    progressWrap.style.display = 'none';
  }
});

function applyLoadedCloud(cloud, fileName) {
  sourceCloud = cloud;
  resultCloud = null;
  sampledSrc = buildSampleIndices(cloud.count, MAX_2D_POINTS);
  sampledDst = null;
  srcCount.textContent = cloud.count.toLocaleString();
  dstCount.textContent = '-';
  btnDownloadSplat.disabled = true;
  btnDownloadPly.disabled = true;
  infoBox.textContent = '已加载「' + fileName + '」';
  infoBox.classList.remove('err', 'warn');

  var n = cloud.count, step = Math.max(1, Math.floor(n / 2000)), vals = [];
  for (var i = 0; i < n; i += step) vals.push(Math.max(cloud.scales[3*i], cloud.scales[3*i+1], cloud.scales[3*i+2]));
  vals.sort(function (a, b) { return a - b; });
  var p70 = vals[Math.floor(vals.length * 0.7)] || 0.002;
  var scaleLogThreshold = Math.max(-6, Math.min(0, Math.log10(Math.max(p70, 1e-6))));
  sliderScale.value = scaleLogThreshold;
  scaleVal.textContent = currentScaleThreshold().toFixed(4);

  restoreRunButton();
  render2D();
  if (panelViewer.classList.contains('active')) updateViewerScene();
}

