var _bufY   = new Float32Array(MAX_2D_POINTS);
var _bufR   = new Float32Array(MAX_2D_POINTS);
var _bufD   = new Float32Array(MAX_2D_POINTS);
var _bufA   = new Float32Array(MAX_2D_POINTS);
var _bufCr  = new Uint8Array(MAX_2D_POINTS);
var _bufCg  = new Uint8Array(MAX_2D_POINTS);
var _bufCb  = new Uint8Array(MAX_2D_POINTS);
var _bucketHead = new Int32Array(BUCKET_COUNT);
