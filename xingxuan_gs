function renderOneCanvas(ctx, cloud, sampleIndices) {
  var w = ctx.canvas.width, h = ctx.canvas.height;
  ctx.clearRect(0, 0, w, h);
  if (!cloud || !sampleIndices || sampleIndices.length === 0) {
    ctx.fillStyle = 'rgba(100, 116, 139, 0.5)';
    ctx.font = '500 14px Inter, sans-serif';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText('暂无数据', w / 2, h / 2);
    return;
  }
  precomputeCamera(w, h);

  var n = sampleIndices.length;
  var listLen = 0;
  var minD = Infinity, maxD = -Infinity;

  for (var k = 0; k < n; k++) {
    var i = sampleIndices[k];
    var px = cloud.positions[3*i], py = cloud.positions[3*i+1], pz = cloud.positions[3*i+2];
    var x1 = px * _cosY - pz * _sinY;
    var z1 = px * _sinY + pz * _cosY;
    var y1 = py * _cosX - z1 * _sinX;
    var z2 = py * _sinX + z1 * _cosX;
    var zc = z2 - _dist;
    if (zc >= -0.01) continue;
    var s = _focal / (-zc);
    var screenX = w / 2 + x1 * s;
    var screenY = h / 2 - y1 * s;

    var sx = cloud.scales[3*i], sy = cloud.scales[3*i+1], sz = cloud.scales[3*i+2];
    var sm = Math.sqrt(sx * sy);
    if (sz > sm) sm = Math.max(sm, Math.sqrt(sx * sz) * 0.5 + Math.sqrt(sy * sz) * 0.5);
    var r = s * sm;
    if (r < 0.5) r = 0.5;
    var maxR = Math.min(w, h) * 0.15;
    if (r > maxR) r = maxR;
    if (screenX < -r || screenX > w + r || screenY < -r || screenY > h + r) continue;

    _bufX[listLen] = screenX;
    _bufY[listLen] = screenY;
    _bufR[listLen] = r;
    _bufD[listLen] = zc;
    _bufA[listLen] = cloud.opacities[i];
    _bufCr[listLen] = cloud.colors[3*i];
    _bufCg[listLen] = cloud.colors[3*i+1];
    _bufCb[listLen] = cloud.colors[3*i+2];
    if (zc < minD) minD = zc;
    if (zc > maxD) maxD = zc;
