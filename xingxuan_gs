    else if (b >= BUCKET_COUNT) b = BUCKET_COUNT - 1;
    _bucketNext[j] = _bucketHead[b];
    _bucketHead[b] = j;
  }

  for (var bi = 0; bi < BUCKET_COUNT; bi++) {
    var jj = _bucketHead[bi];
